# Beam hardening of an X-ray tube: a 100 kVp bremsstrahlung spectrum (Kramers' law, inherent filtration ignored)
# is sent through nothing, 2.5 mm of aluminium (the minimum for diagnostic tubes) and 2.5 mm Al + 0.2 mm Cu
# (a CT-style filter). The soft photons that would only add skin dose are removed; the mean energy rises and the
# beam becomes more penetrating (its half-value layer in aluminium grows), at the price of intensity.
mkdir("build/visuals");
mkdir("docs/images");
compute = _dsl_ cli="lmparticle" install="github:lmctl-ai/lmparticle@latest";
let al = rad.builtin("aluminum");
let cu = rad.builtin("copper");
let s = rad.source().point(0.0, 0.0, -1.0).beam(0.0, 0.0, 1.0);
for (i in range(0, 19)) {
  let e = 0.005 * float(i + 1);          # 5, 10, ... 95 keV
  s.line(e, (0.1 - e) / e);               # Kramers: energy intensity (E0 - E), so photon number (E0 - E) / E
}
let rows = "";
for (k in range(0, 3)) {
  let g = rad.geometry();
  if (k == 0) { g.slab("al", al, 0.0, 0.0001); }   # effectively no filter (1 um of aluminium)
  if (k == 1) { g.slab("al", al, 0.0, 0.25); }
  if (k == 2) { g.slab("al", al, 0.0, 0.25).slab("cu", cu, 0.25, 0.27); }
  let r = rad.simulation(g, s).plane("out", "z", 0.3).spectrum(20, 0.1).no_rayleigh().seed(1300 + k).run(400000);
  r.save_plane_spectrum("out", "build/visuals/tube_" + str(k) + ".csv");
  let n = r.plane_count("out");
  let mean = r.plane_energy("out") / n;
  # half-value layer of the filtered beam in aluminium: found by adding aluminium until half the photons remain
  let lo = 0.0;
  let hi = 2.0;
  let n0 = r.plane_uncollided("out");
  for (it in range(0, 12)) {
    let mid = 0.5 * (lo + hi);
    let g2 = rad.geometry();
    if (k == 0) { g2.slab("al", al, 0.0, 0.0001 + mid); }
    if (k == 1) { g2.slab("al", al, 0.0, 0.25 + mid); }
    if (k == 2) { g2.slab("al", al, 0.0, 0.25).slab("cu", cu, 0.25, 0.27).slab("al2", al, 0.27, 0.27 + mid); }
    let r2 = rad.simulation(g2, s).plane("out", "z", 3.0).no_rayleigh().seed(1400 + k).run(100000);
    if (r2.plane_uncollided("out") > 0.5 * n0) { lo = mid; } else { hi = mid; }
  }
  let hvl = 0.5 * (lo + hi);
  rad.print("filter " + str(k) + ": transmitted " + str(n) + " of the photons, mean energy " + str(mean * 1000.0) + " keV, HVL " + str(hvl * 10.0) + " mm Al");
  rows = rows + str(k) + " " + str(n) + " " + str(mean * 1000.0) + " " + str(hvl * 10.0) + "\n";
}
rad.save_text("build/visuals/tube_summary.csv", rows);
end _dsl_
savedsl(compute, "build/visuals/tube_filtration-compute.dslb");
r = system ${dsl_cli(compute)} --dsl build/visuals/tube_filtration-compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);
print(r.stdout);
summ = [];
for (line in read_lines("build/visuals/tube_summary.csv")) { if (len(line) > 0) { summ = push(summ, split(line, " ")); } }
assert(num(summ[2][2]) > num(summ[1][2]) && num(summ[1][2]) > num(summ[0][2]), "mean energy rises with filtration");
assert(num(summ[2][3]) > num(summ[1][3]) && num(summ[1][3]) > num(summ[0][3]), "HVL rises with filtration");
assert(num(summ[1][3]) > 1.5 && num(summ[1][3]) < 6.0, "HVL of a 2.5 mm Al filtered 100 kVp beam is a few mm Al");
function tag(k, name) { return name + " (" + str(round(num(summ[k][1]) * 100)) + "% of photons, mean " + str(round(num(summ[k][2]))) + " keV, HVL " + str(round(num(summ[k][3]) * 10) / 10) + " mm Al)"; }
t0 = tag(0, "no filter"); t1 = tag(1, "2.5 mm Al"); t2 = tag(2, "2.5 mm Al + 0.2 mm Cu");
draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/tube_filtration.png", 900, 560);
plot.cmd("set title '100 kVp tube spectrum (Kramers) after filtration: fewer, harder photons'");
plot.cmd("set xlabel 'Photon energy (keV)'; set ylabel 'Transmitted photons per source photon per 5 keV bin'; set label 9 at graph 0.98, graph 0.72 right 'HVL = aluminium halving the photon count (no inherent filtration, no K lines)' font ',9' tc rgb '#555555'; set grid; set key top right; set xrange [0:100]; set yrange [0:*]");
plot.cmd("plot 'build/visuals/tube_0.csv' using (($1+$2)*500):3 with boxes fs solid 0.35 lc rgb '#999999' title '" + ${t0} + "', 'build/visuals/tube_1.csv' using (($1+$2)*500):3 with boxes fs solid 0.5 lc rgb '#1f77b4' title '" + ${t1} + "', 'build/visuals/tube_2.csv' using (($1+$2)*500):3 with boxes fs solid 0.7 lc rgb '#d62728' title '" + ${t2} + "'");
plot.close();
end _dsl_
savedsl(draw, "build/visuals/tube_filtration-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/visuals/tube_filtration-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote docs/images/tube_filtration.png");
