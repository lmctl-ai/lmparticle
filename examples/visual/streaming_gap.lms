# Radiation streaming through a gap: a 4 cm lead wall with a 0.4 cm straight air slit, lit by a broad 662 keV beam.
# A row of 25 tissue cells behind the wall maps the kerma across the slit: the direct streaming peak, the shadow
# of the lead, and how much the slit raises the dose next to it (scatter off the slit walls). Also drawn with
# lmdraw: the wall, the slit, the beam and the detector row.
mkdir("build/visuals");
mkdir("build/rendered");
mkdir("docs/images");
mkdir("images");
compute = _lmcode_ cli="lmparticle" install="github:lmctl-ai/lmparticle@latest";
let lead = rad.builtin("lead");
let air = rad.builtin("air");
let tissue = rad.builtin("tissue");
let rows = "";
for (variant in range(0, 2)) {
  let g = rad.geometry();
  # the slit first so it wins inside the wall; variant 1 is the solid wall for comparison
  if (variant == 0) { g.box("slit", air, -0.2, 0.2, -50.0, 50.0, 0.0, 4.0); }
  g.box("wall", lead, -25.0, 25.0, -50.0, 50.0, 0.0, 4.0);
  for (i in range(0, 25)) {
    let x = -6.0 + 0.5 * float(i);
    g.box("c" + str(i), tissue, x - 0.25, x + 0.25, -50.0, 50.0, 4.0, 5.0);
  }
  # a disc source 8 cm across, pointing at the wall, is the broad beam
  let s = rad.source().point(0.0, 0.0, -2.0).beam(0.0, 0.0, 1.0).disc(8.0).energy(0.662);
  let r = rad.simulation(g, s).implicit_capture(0.05).seed(2200 + variant).run(2000000);
  for (i in range(0, 25)) {
    let x = -6.0 + 0.5 * float(i);
    rows = rows + str(variant) + " " + str(x) + " " + str(r.deposited("c" + str(i))) + " " + str(r.deposited_err("c" + str(i))) + "\n";
  }
  rows = rows + "\n\n";
  if (variant == 0) {
    # the cell behind the slit sees far more than its neighbours two cells away
    rad.assert_true(r.deposited("c12") > 5.0 * r.deposited("c14"));
  }
}
rad.save_text("build/visuals/streaming.csv", rows);
end _lmcode_
savedsl(compute, "build/visuals/streaming_gap-compute.dslb");
r = system ${dsl_cli(compute)} --lmcode build/visuals/streaming_gap-compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);
draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/streaming_gap.png", 900, 560);
plot.cmd("set title 'Streaming through a 4 mm slit in a 4 cm lead wall, broad 662 keV beam: kerma behind the wall'");
plot.cmd("set xlabel 'Position across the wall (cm)'; set ylabel 'Kerma per source photon (MeV, 5 mm cell)'; set logscale y; set grid; set key top right; set xrange [-6.3:6.3]");
plot.cmd("set object 1 rect from -0.2,graph 0 to 0.2,graph 1 fc rgb '#e0f0ff' fs solid noborder behind; set label 1 at 0,graph 0.95 center 'slit' tc rgb '#1f77b4'");
plot.cmd("plot 'build/visuals/streaming.csv' index 0 using 2:3:4 with yerrorlines pt 7 lw 2 lc rgb '#d62728' title 'wall with slit', '' index 1 using 2:3:4 with yerrorlines pt 5 lw 2 lc rgb '#7f7f7f' title 'solid wall'");
plot.close();
end _lmcode_
savedsl(draw, "build/visuals/streaming_gap-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/visuals/streaming_gap-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote docs/images/streaming_gap.png");

sketch = _lmcode_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900, 400, "#ffffff");
scene.text(230.0, 36.0, 20.0, "Slit in a lead wall: side view, 50 px per cm", "#222222");
scene.rect(150.0, 150.0, 290.0, 200.0, "#9a9a9a").set_attr("stroke", "#555555").set_attr("stroke-width", "1.5");
scene.rect(460.0, 150.0, 290.0, 200.0, "#9a9a9a").set_attr("stroke", "#555555").set_attr("stroke-width", "1.5");
scene.text(160.0, 260.0, 14.0, "lead wall, 4 cm thick", "#333333");
scene.rect(440.0, 150.0, 20.0, 200.0, "#e0f0ff");
scene.text(362.0, 140.0, 12.0, "air slit 4 mm", "#1f77b4");
scene.line(150.0, 60.0, 750.0, 60.0, "#d62728", 3.0);
scene.text(150.0, 52.0, 13.0, "broad beam source (disc), 2 cm in front of the wall", "#d62728");
scene.arrow(250.0, 62.0, 250.0, 148.0, "#d62728", 1.5);
scene.arrow(350.0, 62.0, 350.0, 148.0, "#d62728", 1.5);
scene.arrow(450.0, 62.0, 450.0, 352.0, "#d62728", 2.5);
scene.arrow(550.0, 62.0, 550.0, 148.0, "#d62728", 1.5);
scene.arrow(650.0, 62.0, 650.0, 148.0, "#d62728", 1.5);
scene.rect(150.0, 352.0, 600.0, 14.0, "#f7d9c4").set_attr("stroke", "#b07a5a").set_attr("stroke-width", "1.0");
scene.text(150.0, 385.0, 13.0, "25 tissue cells, 5 mm each, 1 cm deep", "#7a4a2a");
scene.text(770.0, 250.0, 13.0, "x", "#555555");
scene.arrow(760.0, 250.0, 820.0, 250.0, "#555555", 1.5);
scene.render_png("build/rendered/streaming_layout.png", 900, 400, 1);
end _lmcode_
savedsl(sketch, "build/visuals/streaming_gap-sketch.dslb");
r = system ${dsl_cli(sketch)} --lmcode build/visuals/streaming_gap-sketch.dslb;
assert(r.code == 0, r.stdout + r.stderr);
copy_file("build/rendered/streaming_layout.png", "docs/images/streaming_layout.png");
println("wrote docs/images/streaming_layout.png");
