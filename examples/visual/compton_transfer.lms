# Analytic mean Compton energy transfer versus a seeded 10,000-sample estimate.
mkdir("build/visuals");
mkdir("docs/images");
compute = _lmcode_ cli="lmparticle" install="github:lmctl-ai/lmparticle@latest";
let rows = "energy_MeV analytic_transfer sampled_transfer\n";
for (i in range(0, 10)) {
  let e = 0.1 + 0.5 * float(i);
  let analytic = rad.compton_mean_transfer(e);
  let sampled = 1.0 - rad.sample_compton_mean(e, 10000, 700 + i);
  rad.assert_close(sampled, analytic, 0.025);
  rows = rows + str(e) + " " + str(analytic) + " " + str(sampled) + "\n";
}
rad.assert_true(rad.compton_mean_transfer(0.1) < rad.compton_mean_transfer(1.0));
rad.save_text("build/visuals/compton_transfer.csv", rows);
end _lmcode_
savedsl(compute, "build/visuals/compton_transfer-compute.dslb");
r = system ${dsl_cli(compute)} --lmcode build/visuals/compton_transfer-compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/compton_transfer.png", 900, 560);
plot.cmd("set title 'Mean Compton energy transfer'; set xlabel 'Photon energy (MeV)'; set ylabel 'Transferred fraction'; set grid; set key outside right top");
plot.cmd("plot 'build/visuals/compton_transfer.csv' every ::1 using 1:2 with linespoints lw 2 pt 7 title 'analytic', '' every ::1 using 1:3 with points pt 5 ps 1.2 title '10,000-sample estimate'");
plot.close();
end _lmcode_
savedsl(draw, "build/visuals/compton_transfer-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/visuals/compton_transfer-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);

println("wrote docs/images/compton_transfer.png");
