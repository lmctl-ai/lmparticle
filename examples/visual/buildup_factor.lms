# The buildup factor: how much the scattered photons add to the kerma of the uncollided beam at a depth in an
# infinite medium. A 1 MeV point isotropic source sits at the centre of a large sphere of water, iron or lead;
# thin spherical shells at 1 ... 7 mean free paths are the dosimeters (their total kerma over the first-collision
# part is the kerma buildup factor of the medium). Published exposure buildup factors for water at 1 MeV
# (ANSI/ANS-6.4.3, point isotropic): 2.08 at 1 mfp and 3.62 at 2 mfp; in water kerma and exposure buildup agree
# closely. In lead the scattered photons are soft and lead absorbs them strongly, so its energy-deposition buildup
# is larger than its exposure (air kerma) buildup factor; both stay well below water's.
mkdir("build/visuals");
mkdir("docs/images");
compute = _lmcode_ cli="lmparticle" install="github:lmctl-ai/lmparticle@latest";
let rows = "";
for (m in range(0, 3)) {
  let mat = rad.builtin("water");
  if (m == 1) { mat = rad.builtin("iron"); }
  if (m == 2) { mat = rad.builtin("lead"); }
  let mfp = mat.mfp(1.0);
  let g = rad.geometry();
  # each inner ball is listed before its shell so the shell region is 0.2 mfp thick, centred on 1, 2, 3, 4, 5, 7 mfp;
  # all are listed before the bulk sphere, which fills the rest
  for (k in range(0, 6)) {
    let d = float(k + 1);
    if (k == 5) { d = 7.0; }
    g.sphere("i" + str(k), mat, 0.0, 0.0, 0.0, (d - 0.1) * mfp);
    g.sphere("s" + str(k), mat, 0.0, 0.0, 0.0, (d + 0.1) * mfp);
  }
  g.sphere("bulk", mat, 0.0, 0.0, 0.0, 12.0 * mfp);
  let s = rad.source().point(0.0, 0.0, 0.0).isotropic().energy(1.0);
  let r = rad.simulation(g, s).implicit_capture(0.02).seed(2100 + m).run(1000000);
  for (k in range(0, 6)) {
    let d = float(k + 1);
    if (k == 5) { d = 7.0; }
    let total = r.deposited("s" + str(k));
    let unc = r.deposited_uncollided("s" + str(k));
    let b = total / unc;
    rows = rows + str(m) + " " + str(d) + " " + str(b) + " " + str(b * (r.deposited_err("s" + str(k)) / total + r.deposited_uncollided_err("s" + str(k)) / unc)) + "\n";
    rad.print("material " + str(m) + " at " + str(d) + " mfp: B = " + str(b));
    if (m == 0 && k == 0) { rad.assert_true(b > 1.7 && b < 2.5); }
    if (m == 0 && k == 1) { rad.assert_true(b > 3.0 && b < 4.3); }
    if (m == 2 && k == 1) { rad.assert_true(b < 2.5); }   # lead builds up far less than water (3.6) at 2 mfp
  }
  rows = rows + "\n\n";
}
rad.save_text("build/visuals/buildup_factor.csv", rows);
end _lmcode_
savedsl(compute, "build/visuals/buildup_factor-compute.dslb");
r = system ${dsl_cli(compute)} --lmcode build/visuals/buildup_factor-compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);
print(r.stdout);
write("build/visuals/buildup_published.csv", "1 2.08\n2 3.62\n");
draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/buildup_factor.png", 900, 560);
plot.cmd("set title 'Buildup factor of a 1 MeV point isotropic source in an infinite medium (kerma in the medium itself)'");
plot.cmd("set xlabel 'Depth (mean free paths)'; set ylabel 'Buildup factor B = total kerma / uncollided kerma'; set grid; set key top left; set xrange [0:7.5]; set yrange [1:*]");
plot.cmd("set label 1 at 1.15,2.08 left 'ANS-6.4.3 water: 2.08' font ',9' tc rgb '#555555'; set label 2 at 2.15,3.62 left '3.62' font ',9' tc rgb '#555555'");
plot.cmd("plot 'build/visuals/buildup_factor.csv' index 0 using 2:3:4 with yerrorlines pt 7 lw 2 lc rgb '#1f77b4' title 'water', '' index 1 using 2:3:4 with yerrorlines pt 5 lw 2 lc rgb '#7f7f7f' title 'iron', '' index 2 using 2:3:4 with yerrorlines pt 9 lw 2 lc rgb '#d62728' title 'lead', 'build/visuals/buildup_published.csv' using 1:2 with points pt 12 ps 2 lw 2 lc rgb '#333333' title 'published (water, exposure, ANS-6.4.3)'");
plot.close();
end _lmcode_
savedsl(draw, "build/visuals/buildup_factor-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/visuals/buildup_factor-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote docs/images/buildup_factor.png");
