# The textbook map of photon interactions: for every element in the embedded XCOM table, the energy where the
# photoelectric and Compton coefficients are equal and the energy where Compton and pair production are equal,
# found by bisection on the tables. Between the two curves Compton scattering dominates; below, photoabsorption;
# above, pair production. Iodine, tungsten and lead keep photoabsorption up to ~0.5 MeV; water loses it at 25 keV.
mkdir("build/visuals");
mkdir("docs/images");
compute = _dsl_ cli="lmparticle" install="github:lmctl-ai/lmparticle@latest";
let rows = "";
# the DSL has no arrays: the 19 elements and their Z are spelled out
for (i in range(0, 19)) {
  let sym = "H";
  let z = "1";
  if (i == 1) { sym = "C"; z = "6"; }
  if (i == 2) { sym = "N"; z = "7"; }
  if (i == 3) { sym = "O"; z = "8"; }
  if (i == 4) { sym = "Na"; z = "11"; }
  if (i == 5) { sym = "Mg"; z = "12"; }
  if (i == 6) { sym = "Al"; z = "13"; }
  if (i == 7) { sym = "Si"; z = "14"; }
  if (i == 8) { sym = "P"; z = "15"; }
  if (i == 9) { sym = "S"; z = "16"; }
  if (i == 10) { sym = "Ar"; z = "18"; }
  if (i == 11) { sym = "K"; z = "19"; }
  if (i == 12) { sym = "Ca"; z = "20"; }
  if (i == 13) { sym = "Fe"; z = "26"; }
  if (i == 14) { sym = "Cu"; z = "29"; }
  if (i == 15) { sym = "Ge"; z = "32"; }
  if (i == 16) { sym = "I"; z = "53"; }
  if (i == 17) { sym = "W"; z = "74"; }
  if (i == 18) { sym = "Pb"; z = "82"; }
  let m = rad.material(sym, 1.0).element(sym, 1.0);
  # photo = compton crossover: bisection in log energy between 1 keV and 20 MeV (photo wins at the low end)
  let lo = 0.001;
  let hi = 20.0;
  for (it in range(0, 50)) {
    let mid = pow(lo * hi, 0.5);
    if (m.mu_partial(mid, "photo") > m.mu_partial(mid, "compton")) { lo = mid; } else { hi = mid; }
  }
  let e1 = pow(lo * hi, 0.5);
  # compton = pair crossover between 1.022 and 20 MeV; for the lightest elements pair never wins below 20 MeV
  lo = 1.03;
  hi = 20.0;
  let e2 = -1.0;
  if (m.mu_partial(20.0, "pair") > m.mu_partial(20.0, "compton")) {
    for (it in range(0, 50)) {
      let mid = pow(lo * hi, 0.5);
      if (m.mu_partial(mid, "compton") > m.mu_partial(mid, "pair")) { lo = mid; } else { hi = mid; }
    }
    e2 = pow(lo * hi, 0.5);
  }
  rows = rows + z + " " + str(e1) + " " + str(e2) + " " + sym + "\n";
}
rad.save_text("build/visuals/dominance.csv", rows);
end _dsl_
savedsl(compute, "build/visuals/dominance_map-compute.dslb");
r = system ${dsl_cli(compute)} --dsl build/visuals/dominance_map-compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);
# known crossovers: lead photo = Compton near 0.5 MeV, Compton = pair near 4.8 MeV; water (oxygen) photo = Compton near 25 keV
vals = [];
for (line in read_lines("build/visuals/dominance.csv")) { if (len(line) > 0) { vals = push(vals, split(line, " ")); } }
pb = vals[18]; o = vals[3];
println(f"lead: photoelectric = Compton at {pb[1]} MeV, Compton = pair at {pb[2]} MeV; oxygen: photoelectric = Compton at {o[1]} MeV");
assert(num(pb[1]) > 0.4 && num(pb[1]) < 0.6 && num(pb[2]) > 4.0 && num(pb[2]) < 5.5 && num(o[1]) > 0.02 && num(o[1]) < 0.035, "crossover energies");
draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/dominance_map.png", 900, 560);
plot.cmd("set title 'Which photon interaction dominates: crossover energies from the XCOM tables, element by element'");
plot.cmd("set logscale y; set xlabel 'Atomic number Z'; set ylabel 'Photon energy (MeV)'; set xrange [0:90]; set yrange [0.001:20]; set grid; set key off");
plot.cmd("set style fill transparent solid 0.18 noborder");
plot.cmd("set label 1 at 45,0.012 center 'photoelectric effect dominant' tc rgb '#7b3294' font ',12'");
plot.cmd("set label 2 at 45,0.9 center 'Compton scattering dominant' tc rgb '#008837' font ',12'");
plot.cmd("set label 3 at 62,12 center 'pair production dominant' tc rgb '#ca0020' font ',12'");
plot.cmd("plot 'build/visuals/dominance.csv' using 1:2:(0.001) with filledcurves lc rgb '#7b3294' notitle, '' using 1:($3 > 0 ? $3 : 20):(20) with filledcurves lc rgb '#ca0020' notitle, '' using 1:2 with linespoints pt 7 lw 2 lc rgb '#7b3294' notitle, '' using 1:($3 > 0 ? $3 : 1/0) with linespoints pt 7 lw 2 lc rgb '#ca0020' notitle, '' using 1:2:4 with labels offset 0,-1 font ',9' notitle");
plot.close();
end _dsl_
savedsl(draw, "build/visuals/dominance_map-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/visuals/dominance_map-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote docs/images/dominance_map.png");
