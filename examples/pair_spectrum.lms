# What leaves 2 cm of lead after 6 MeV photons: transmitted spectrum with the 511 keV annihilation line.
mkdir("build/examples");
mkdir("docs/images");
out = ARGV.len() > 0 ? ARGV[0] : "build/pair_spectrum.dslb";
p = _lmcode_ cli="lmparticle" install="github:lmctl-ai/lmparticle@latest";
let pb = rad.builtin("lead");
let g = rad.geometry();
g.slab("lead", pb, 0.0, 2.0);
let s = rad.source();
s.point(0.0, 0.0, -1.0).beam(0.0, 0.0, 1.0).energy(6.0);
let r = rad.simulation(g, s).plane("behind", "z", 2.0).spectrum(120, 6.0).seed(5).run(400000);
r.save_plane_spectrum("behind", "build/examples/pair_spectrum.csv");
rad.print("pair events per photon " + str(r.interactions("pair")) + ", Compton " + str(r.interactions("compton")));
rad.assert_true(r.interactions("pair") > 0.1);
rad.assert_close(r.total_deposited() + r.escaped_energy(), 6.0, 0.000000001);
# 511 keV is bin 10 (500-550 keV) of the 50 keV grid: annihilation photons stand out against the neighbouring bins
rad.assert_true(r.plane_count("behind") > r.plane_uncollided("behind"));
end _lmcode_
savedsl(p, out);
if (ARGV.len() == 0) {
  r = system ${dsl_cli(p)} --lmcode ${out};
  assert(r.code == 0, r.stdout + r.stderr);
  plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
  plot.png("docs/images/pair_spectrum.png", 900, 560);
  plot.cmd("set title '6 MeV photons after 2 cm of lead: the 511 keV annihilation line and the degraded continuum'; set xlabel 'Energy (MeV)'; set ylabel 'Transmitted fraction per bin'; set logscale y; set yrange [0.00001:1]; set grid; set key off");
  plot.cmd("set label 1 at 0.6,0.08 left '511 keV (positron annihilation)'; set label 2 at 5.8,0.5 right 'uncollided 6 MeV'");
  plot.cmd("plot 'build/examples/pair_spectrum.csv' using 1:3 with steps lw 2 lc rgb '#2ca02c'");
  plot.close();
end _lmcode_
  savedsl(plot, "build/pair_spectrum-plot.dslb");
  r = system ${dsl_cli(plot)} --lmcode build/pair_spectrum-plot.dslb;
  assert(r.code == 0, r.stdout + r.stderr);
  println("wrote docs/images/pair_spectrum.png");
}
