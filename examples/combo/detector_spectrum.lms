# Pulse-height spectrum of a NaI crystal exposed to Cs-137: photopeak and Compton continuum.
# Two hosts in one script: lmparticle runs the Monte Carlo and writes a CSV, lmplot (gnuplot in a static binary) draws it.
# Needs lmplot on PATH or installable; the PNG lands in build/examples/detector_spectrum.png.
mkdir("build/examples");
mkdir("docs/images");
sim = _lmcode_ cli="lmparticle" install="github:lmctl-ai/lmparticle@latest";

let nai = rad.builtin("nai");
let g = rad.geometry();
g.box("crystal", nai, -3.8, 3.8, -3.8, 3.8, 10.0, 17.6);
let s = rad.source();
s.point(0.0, 0.0, 0.0).isotropic().energy(0.662);
let r = rad.simulation(g, s).spectrum(165, 0.825).pulse_height("crystal").seed(2024).run(2000000);
r.save_pulse_height("crystal", "build/examples/detector_spectrum.csv");
end _lmcode_
savedsl(sim, "build/detector_spectrum-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode build/detector_spectrum-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("build/examples/detector_spectrum.png", 900, 600);
plot.cmd("set title 'NaI pulse-height spectrum, 662 keV (lmparticle Monte Carlo, drawn by lmplot)'");
plot.cmd("set xlabel 'energy deposited [MeV]'");
plot.cmd("set ylabel 'counts per emitted photon per bin'");
plot.cmd("set logscale y");
plot.cmd("set yrange [1e-7:*]");
plot.cmd("unset key");
plot.cmd("plot 'build/examples/detector_spectrum.csv' using 1:3 with steps lw 2");
plot.close();
end _lmcode_
savedsl(draw, "build/detector_spectrum-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/detector_spectrum-draw.dslb;
assert(r.code == 0);
println("wrote build/examples/detector_spectrum.png");
assert(copy_file("build/examples/detector_spectrum.png", "docs/images/detector_spectrum.png"));
