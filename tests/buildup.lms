# Buildup: scattered photons add to the uncollided beam, more so in thick low-Z shields (counts of forward crossings of the exit plane).
out = ARGV.len() > 0 ? ARGV[0] : "build/buildup.dslb";
p = _dsl_ cli="lmparticle";
let water = rad.builtin("water");
let pb = rad.builtin("lead");
let s = rad.source();
s.point(0.0, 0.0, -1.0).beam(0.0, 0.0, 1.0).energy(1.0);
let last = 1.0;
for (i in range(0, 4)) {
  let t = 2.0 + 6.0 * float(i * i);
  let g = rad.geometry();
  g.slab("w", water, 0.0, t);
  let r = rad.simulation(g, s).plane("e", "z", t).seed(31).run(200000);
  let b = r.plane_count("e") / r.plane_uncollided("e");
  rad.assert_true(b > last);       # buildup grows with thickness
  last = b;
  if (i == 2) { rad.assert_true(b > 2.5 && b < 4.5); }    # about 3.3 at 1.8 mean free paths
  if (i == 3) { rad.assert_true(b > 5.5 && b < 9.5); }    # about 7.6 at 4 mean free paths
}
# at 0.5 MeV the same number of mean free paths gives far less buildup in lead than in water (photoabsorption removes scattered photons)
let s2 = rad.source();
s2.point(0.0, 0.0, -1.0).beam(0.0, 0.0, 1.0).energy(0.5);
let gl = rad.geometry();
gl.slab("pb", pb, 0.0, 1.0);
let rl = rad.simulation(gl, s2).plane("e", "z", 1.0).seed(32).run(200000);
let gw = rad.geometry();
gw.slab("w", water, 0.0, 1.83 / water.mu(0.5));
let rw = rad.simulation(gw, s2).plane("e", "z", 1.83 / water.mu(0.5)).seed(32).run(200000);
rad.assert_true(rl.plane_count("e") / rl.plane_uncollided("e") < 0.8 * rw.plane_count("e") / rw.plane_uncollided("e"));
# transmitted energy per crossing photon is below the source energy in the thick shield (degraded spectrum)
rad.assert_true(rw.plane_energy("e") / rw.plane_count("e") < 0.5);
end _dsl_
savedsl(p, out);
