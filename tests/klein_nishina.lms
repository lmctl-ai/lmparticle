# Klein-Nishina: total cross section (analytic), mean energy transfer (numerical integral) and the Compton sampler (Monte Carlo).
out = ARGV.len() > 0 ? ARGV[0] : "build/klein_nishina.dslb";
p = _lmcode_ cli="lmparticle";
# total cross section per electron in barn (1 barn = 1e-24 cm2): 0.2112 at 1 MeV, 0.2866 at 511 keV, 0.0517 at 10 MeV (XCOM free-electron values)
let barn = 0.000000000000000000000001;
rad.assert_close(rad.klein_nishina(1.0) / barn, 0.2112, 0.0001);
rad.assert_close(rad.klein_nishina(0.511) / barn, 0.2866, 0.0002);
rad.assert_close(rad.klein_nishina(10.0) / barn, 0.0512, 0.0004);
# low-energy limit: the Thomson cross section 0.6652 barn, approached from below as 1 - 2k
rad.assert_close(rad.klein_nishina(0.001) / barn, 0.6652 * (1.0 - 2.0 * 0.001 / 0.51099895 + 5.2 * 0.001 * 0.001 / 0.51099895 / 0.51099895), 0.0001);
rad.assert_true(rad.klein_nishina(0.01) < rad.klein_nishina(0.001));
# mean fraction of the energy given to the electron: 0.440 at 1 MeV (Evans, The Atomic Nucleus), growing with energy
rad.assert_close(rad.compton_mean_transfer(1.0), 0.4400, 0.0005);
rad.assert_true(rad.compton_mean_transfer(0.1) < rad.compton_mean_transfer(1.0));
rad.assert_true(rad.compton_mean_transfer(1.0) < rad.compton_mean_transfer(10.0));
rad.assert_true(rad.compton_mean_transfer(0.01) < 0.02);
# the sampler reproduces the Klein-Nishina mean of E'/E at several energies (2e6 samples, standard error ~2e-4)
let e = 0.05;
for (i in range(0, 5)) {
  rad.assert_close(rad.sample_compton_mean(e, 2000000, 11 + i), 1.0 - rad.compton_mean_transfer(e), 0.001);
  e = e * 3.0;
}
# same seed, same samples; a different seed differs
rad.assert_close(rad.sample_compton_mean(1.0, 1000, 5), rad.sample_compton_mean(1.0, 1000, 5), 0.0);
rad.assert_true(rad.sample_compton_mean(1.0, 1000, 5) != rad.sample_compton_mean(1.0, 1000, 6));
end _lmcode_
savedsl(p, out);
